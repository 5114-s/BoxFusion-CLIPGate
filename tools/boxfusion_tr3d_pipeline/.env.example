# Copy this file to .env and update paths for the current machine.
# Load it with: set -a; source .env; set +a

BOXFUSION_LIVE_ROOT=/data/ZhaoX/BoxFusion
BOXFUSION_ENV_ROOT=/home/admin1/miniconda3/envs/boxfusion-online
BOXFUSION_TR3D_TERMINAL_ARTIFACT_BASE=/data/ZhaoX/BoxFusion/tools/boxfusion_tr3d_pipeline
# To relocate Boxer itself, copy the packaged YAML, update lifting.boxer paths,
# and point this variable at that machine-local config.
# BOXFUSION_ONLINE_CONFIG=/absolute/path/to/scannet_b6_selective_boxer.local.yaml

# The 17 KiB hash-frozen B6 calibrator is included under models/. Override only
# if intentionally testing another checkpoint.
BOXFUSION_QUALITY_CHECKPOINT=/data/ZhaoX/BoxFusion/tools/boxfusion_tr3d_pipeline/models/scannet_b6_iou_mlp.npz
# YOLOE remains an external large model.
BOXFUSION_YOLOE_CHECKPOINT=/data/ZhaoX/OVM3D-Dett/boxfusion_b6_selective_boxer_dev/models/yoloe-11s-seg-pf.pt

# Frozen terminal-TR3D inputs. The launchers accept every path as an override.
BOXFUSION_R3_PREFIX_MANIFEST=/data/ZhaoX/OVM3D-Dett/boxfusion_tr3d_r2_verifier_dev/data/tr3d_prefix_val100_boxfusion_causal_p100_v3/manifests/trajectory_prefix_val100_boxfusion_causal_p100_v3.jsonl
BOXFUSION_R3_PARENT_CACHE_ROOT=/data/ZhaoX/OVM3D-Dett/boxfusion_tr3d_r2_verifier_dev/cache/tr3d_prefix_boxfusion_causal_p100_full100_v3
BOXFUSION_R3_FROZEN_G0_ROOT=/data/ZhaoX/OVM3D-Dett/boxfusion_b6_selective_boxer_dev/results/b6_selective_boxer/s1_selective/scannetv2_val-4b18fc586f7a
BOXFUSION_R3_SHADOW_GOLD_ROOT=/data/ZhaoX/OVM3D-Dett/boxfusion_tr3d_r2_verifier_dev/results/tr3d_r3_shadow_active/r3_shadow_active_full100_v1
BOXFUSION_R3_FROZEN_MANIFEST=/data/ZhaoX/OVM3D-Dett/boxfusion_tr3d_r2_verifier_dev/manifests/frozen_g0_selective_boxer_full100.json
BOXFUSION_R3_SHADOW_MANIFEST=/data/ZhaoX/OVM3D-Dett/boxfusion_tr3d_r2_verifier_dev/reports/tr3d_r3_shadow_active/r3_shadow_active_full100_v1/materialize_manifest.json

# C3 online identity/shadow evidence.
BOXFUSION_C3_ONLINE_C2_CACHE_ROOT=/data/ZhaoX/OVM3D-Dett/boxfusion_tr3d_residual_track_dev/artifacts/tr3d_c2_maskrgbd/c2_c1top10_full100_v1/cache
BOXFUSION_C3_ONLINE_PARENT_CACHE_ROOT=/data/ZhaoX/OVM3D-Dett/boxfusion_tr3d_r2_verifier_dev/cache/tr3d_prefix_boxfusion_causal_p100_full100_v3
